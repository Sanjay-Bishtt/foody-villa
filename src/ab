* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
.header{
  display: flex;
justify-content: space-between;
border: 1px solid black;
}
.logo{
  width: 100px;
}
.nav-items>ul{
  display: flex;
  font-size: 20px;
  list-style: none;

}
.nav-items>ul>li{
  padding: 10px;
  margin: 10px;
}
.res-card{
  width:200px;
  height: 320px;
  padding: 5px;
  margin: 5px;

}
.filter-btn{
  margin: 10px;
  cursor: pointer;
}
.search{
  padding: 10px;
}
.res-image{
  width: 190px;
  

}
.res-container{
  display: flex;
  flex-wrap:wrap ;

}
.shimmer-container {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  padding: 16px;
}

.shimmer-card {
  width: 200px;
  background: #f0f0f0;
  border-radius: 8px;
  padding: 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.shimmer-image {
  width: 100%;
  height: 120px;
  border-radius: 6px;
  background: linear-gradient(
    90deg,
    #e0e0e0 25%,
    #f5f5f5 37%,
    #e0e0e0 63%
  );
  background-size: 400% 100%;
  animation: shimmer 1.5s infinite;
  margin-bottom: 12px;
}

.shimmer-text {
  height: 16px;
  border-radius: 4px;
  margin-bottom: 8px;
  background: linear-gradient(
    90deg,
    #e0e0e0 25%,
    #f5f5f5 37%,
    #e0e0e0 63%
  );
  background-size: 400% 100%;
  animation: shimmer 1.5s infinite;
}

.shimmer-text.title {
  width: 70%;
  height: 20px;
}

.shimmer-text.subtitle {
  width: 50%;
}

@keyframes shimmer {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}
.filter{
  display: flex;
}
.login{
  cursor: pointer;
  height: 20px;
   
}
